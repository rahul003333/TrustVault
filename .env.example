
# Local development only — use real values in your untracked .env file
DB_URL=jdbc:postgresql://localhost:5432/trustvault
DB_USERNAME=trustvault
DB_PASSWORD=replace_with_a_local_password

# Generate a strong Base64-encoded JWT secret; never commit the real secret.
JWT_SECRET=replace_with_a_base64_encoded_secret

# Local-development defaults
DDL_AUTO=update
SHOW_SQL=false
SECURITY_LOG_LEVEL=INFO
PORT=8082

# Document storage directory; confirm the application reads this setting.
TRUSTVAULT_STORAGE_DIR=./trustvault-files
